<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Modium" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>

        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>

        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>

        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>

        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>

        <item name="android:statusBarColor">@color/m3_background</item>
        <item name="android:navigationBarColor">@color/m3_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Rounder M3 shape language across the app -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Modium.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Modium.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Modium.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Modium.Large</item>

        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Modium.BottomSheet</item>
        <item name="android:windowAnimationStyle">@style/Animation.Modium.Activity</item>
    </style>

    <style name="Theme.Modium.NoActionBar" parent="Theme.Modium">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ShapeAppearance.Modium.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Modium.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Modium.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Modium.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ThemeOverlay.Modium.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Modium.BottomSheet</item>
    </style>

    <style name="Widget.Modium.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/m3_surface_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Modium.Large</item>
    </style>

    <style name="Animation.Modium.Activity" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
    </style>
</resources>
